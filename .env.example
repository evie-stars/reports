# Use PostgreSQL on Plesk where possible.
# Example: postgresql://USER:PASSWORD@HOST:5432/star_reports?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/star_reports?schema=public"

# DataForSEO API credentials from your dashboard. Optional once they are saved under Settings > API keys;
# a key stored in the app takes precedence over these values.
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""

# Safety defaults. Keep sandbox enabled until you are ready for a tiny live test.
DATAFORSEO_SANDBOX="true"
DATAFORSEO_LIVE_ENABLED="false"
DATAFORSEO_MAX_LIVE_TASKS_PER_RUN="1"
DATAFORSEO_MAX_STANDARD_TASKS_PER_RUN="1000"
DATAFORSEO_KEYWORD_METRICS_ENABLED="false"
DATAFORSEO_KEYWORD_METRICS_COST_USD="0.06"

# Outbound request safety. Every provider call is aborted after the timeout; reads are retried, paid task creation never is.
HTTP_TIMEOUT_MS="30000"
DATAFORSEO_TIMEOUT_MS="90000"
HTTP_RETRY_DELAY_MS="500"

# Queue pacing. The worker handles one report at a time and pauses between API tasks.
RANK_QUEUE_DELAY_MS="750"
# Tasks stuck in "submitting" (or created but never posted) for longer than this are reaped or resumed by the worker.
RANK_TASK_STALE_MINUTES="30"
# How long the worker waits before polling DataForSEO again for an unfinished Standard task.
RANK_QUEUE_POLL_INTERVAL_MINUTES="4"
KEYWORD_METRICS_POLL_INTERVAL_MINUTES="10"
# The worker lock expires after this many minutes even if the process dies mid-run.
RANK_QUEUE_LOCK_MINUTES="120"
RANK_QUEUE_MAX_JOBS="1"
RANK_QUEUE_MAX_COLLECT_RUNS="3"
RANK_QUEUE_MAX_TASK_GETS="100"
RANK_QUEUE_MAX_POLL_ATTEMPTS="24"
KEYWORD_METRICS_MAX_POLL_ATTEMPTS="24"
# Maximum scheduled Search Console and Google Analytics imports handled during one worker invocation.
SCHEDULED_REPORT_MAX_GSC_IMPORTS="2"
SCHEDULED_REPORT_MAX_GA4_IMPORTS="2"
RANK_TEAM_COOLDOWN_DAYS="7"

# Optional guard for monthly budgeting.
DATAFORSEO_MONTHLY_BUDGET_USD="1.00"

# Google sign-in remains off until all OAuth values and allowlists are configured.
# A production server (NODE_ENV=production) refuses to start unless this is "true" and AUTH_SECRET is set.
AUTH_ENABLED="false"
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_SESSION_MAX_AGE_HOURS="10"
AUTH_ALLOWED_EMAILS=""
AUTH_ALLOWED_DOMAINS="starwebsites.co.uk"
# Keep at least one emergency administrator here. Manage routine access from the dashboard.
# These environment administrators are also the only users who can change API keys in Settings.
AUTH_ADMIN_EMAILS=""
# Optional legacy/bootstrap manager list. Dashboard-managed roles take precedence.
AUTH_MANAGER_EMAILS=""
RATE_LIMIT_ACTIONS_PER_MINUTE="30"
RATE_LIMIT_PAID_RUNS_PER_HOUR="10"
RATE_LIMIT_SHARE_CHANGES_PER_HOUR="10"
# Page views of the public read-only report links, per caller address.
RATE_LIMIT_SHARE_VIEWS_PER_MINUTE="60"
# Outbound notification emails of one kind across the whole app, and "Send test email" presses per administrator.
RATE_LIMIT_NOTIFICATIONS_PER_HOUR="20"
RATE_LIMIT_NOTIFICATION_TESTS_PER_HOUR="5"
RATE_LIMIT_API_REQUESTS_PER_MINUTE="60"
RATE_LIMIT_GSC_IMPORTS_PER_HOUR="6"
RATE_LIMIT_GA4_IMPORTS_PER_HOUR="6"
RATE_LIMIT_SECRET_CHANGES_PER_HOUR="10"
RANK_WORKER_STALE_MINUTES="15"
AUTH_TRUST_HOST="true"
AUTH_URL="https://reports.starwebsites.co.uk"

# Read-only Google OAuth client shared by the Search Console and Google Analytics 4 integrations
# (separate from the sign-in client). Enable the Search Console API, the Google Analytics Data API
# and the Google Analytics Admin API in the same Google Cloud project. The client ID and secret are
# optional once they are saved under Settings > API keys; the redirect URI always comes from here.
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=""
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=""
GOOGLE_SEARCH_CONSOLE_REDIRECT_URI="https://reports.starwebsites.co.uk/api/integrations/google/callback"

# Master key for everything stored encrypted: Google refresh tokens and the API keys managed in
# Settings. Generate with: openssl rand -hex 32. Only one of the two names needs a value; the
# legacy GOOGLE_SEARCH_CONSOLE_TOKEN_ENCRYPTION_KEY is still read when APP_SECRETS_ENCRYPTION_KEY is empty.
APP_SECRETS_ENCRYPTION_KEY=""
GOOGLE_SEARCH_CONSOLE_TOKEN_ENCRYPTION_KEY=""
# Set only while rotating the master key (see README, "Rotating the master key"), then remove.
APP_SECRETS_PREVIOUS_ENCRYPTION_KEY=""
# Incident response: "environment" makes the app ignore keys stored in Settings and disables the forms.
APP_SECRETS_SOURCE=""

# Email notifications for administrators: new team report requests and scheduled reports that finish
# failed, partial, or blocked. Nothing is sent until NOTIFICATIONS_ENABLED is "true", NOTIFICATIONS_FROM is
# set, and the mailbox is configured (under Settings > API keys, or with the SMTP_* values below).
# The app reads the Plesk environment and the worker reads this file, so set these in both places.
NOTIFICATIONS_ENABLED="false"
# Example: Star Reports <reports@starwebsites.co.uk>
NOTIFICATIONS_FROM=""
# Optional comma-separated recipients (staff mailboxes only; emails name clients and quote error text).
# When empty, every enabled administrator who has signed in is notified.
NOTIFICATION_EMAILS=""
# Authenticated mailbox for sending. Port 587 uses STARTTLS, port 465 uses TLS; plain connections are refused.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# Database backups (npm run db:backup from a daily Plesk scheduled task; the worker's .env is what it reads).
# Archives are written to BACKUP_DIR (created private to the app user; never inside public/), kept for
# BACKUP_RETENTION_DAYS while never dropping below the newest BACKUP_KEEP_MINIMUM files.
BACKUP_DIR="backups"
BACKUP_RETENTION_DAYS="30"
BACKUP_KEEP_MINIMUM="7"
# Directory holding pg_dump and pg_restore when they are not on the task's PATH (for example /usr/pgsql-16/bin).
BACKUP_PG_BIN=""
# Optional empty scratch database on the same server: every backup is restored into it and compared with
# the live data, then emptied again. It must have a different name from the live database.
BACKUP_VERIFY_DATABASE_URL=""
# Each pg_dump / pg_restore step is stopped after this many minutes.
BACKUP_TIMEOUT_MINUTES="60"
# Hours since the last successful backup before it counts as stale (Settings, the dashboard, and the worker's alert email). Set in both Plesk and .env.
BACKUP_STALE_HOURS="26"
