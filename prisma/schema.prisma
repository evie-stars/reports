generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Device {
  desktop
  mobile
}

enum SearchType {
  organic
  local_finder
  maps
}

enum RankRunStatus {
  queued
  running
  completed
  failed
  blocked
}

enum RankRunSource {
  sandbox
  verification
  manual
  scheduled
  import
}

enum RankDirection {
  up
  down
  unchanged
  new
  lost
}

enum ApiDeliveryMethod {
  sandbox
  live
  standard
  import
}

enum RankTaskStatus {
  queued
  submitting
  submitted
  completed
  failed
}

enum KeywordMetricsStatus {
  idle
  queued
  submitting
  submitted
  completed
  failed
}

/// Shared by the Search Console and Analytics import state machines.
enum GscImportStatus {
  idle
  running
  completed
  failed
}

enum ReportModule {
  rankings
  maps
  gsc
  ga4
}

enum ReportExecutionStatus {
  queued
  running
  completed
  partial
  failed
  blocked
}

enum ReportModuleRunStatus {
  not_selected
  queued
  running
  completed
  failed
  blocked
}

enum ReportRequestStatus {
  pending
  reviewed
  completed
}

enum UserRole {
  admin
  manager
  team
}

model UserAccess {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  role         UserRole  @default(team)
  enabled      Boolean   @default(true)
  lastSignInAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([enabled, role])
}

model Client {
  id                  String           @id @default(cuid())
  name                String
  notes               String?
  shareToken          String?          @unique
  shareEnabled        Boolean          @default(false)
  shareCreatedAt      DateTime?
  shareExpiresAt      DateTime?
  shareRevokedAt      DateTime?
  /// Views of the always-current client link; reset whenever the link is created or regenerated.
  shareAccessCount    Int              @default(0)
  shareLastAccessedAt DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  projects            Project[]
  reportSnapshots     ReportSnapshot[]
}

model ReportSnapshot {
  id              String         @id @default(cuid())
  clientId        String
  slug            String
  token           String         @unique
  modules         ReportModule[]
  payload         Json
  expiresAt       DateTime
  revokedAt       DateTime?
  createdByEmail  String
  accessCount     Int            @default(0)
  firstAccessedAt DateTime?
  lastAccessedAt  DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  client          Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@index([expiresAt, revokedAt])
}

model ReportRequest {
  id               String              @id @default(cuid())
  clientName       String
  websiteUrl       String?
  notes            String?
  requestedByEmail String
  requestedByName  String?
  status           ReportRequestStatus @default(pending)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([requestedByEmail, createdAt])
}

model ReportExecution {
  id              String                @id @default(cuid())
  projectId       String
  periodStart     DateTime
  scheduledFor    DateTime
  modules         ReportModule[]
  status          ReportExecutionStatus @default(queued)
  rankingsStatus  ReportModuleRunStatus @default(not_selected)
  gscStatus       ReportModuleRunStatus @default(not_selected)
  ga4Status       ReportModuleRunStatus @default(not_selected)
  rankRunId       String?               @unique
  rankingsError   String?
  gscError        String?
  ga4Error        String?
  gscRowsImported Int                   @default(0)
  ga4RowsImported Int                   @default(0)
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  project         Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rankRun         RankRun?              @relation(fields: [rankRunId], references: [id], onDelete: SetNull)

  @@unique([projectId, periodStart])
  @@index([status, scheduledFor])
  @@index([projectId, createdAt])
}

model Project {
  id                             String               @id @default(cuid())
  clientId                       String
  name                           String
  domain                         String
  targetBusinessName             String?
  serviceArea                    String?
  scheduleEnabled                Boolean              @default(false)
  scheduleDay                    Int                  @default(1)
  scheduleDevices                Device[]             @default([desktop])
  scheduleSearchTypes            SearchType[]         @default([organic])
  schedulePageLimit              Int                  @default(10)
  reportModules                  ReportModule[]       @default([rankings, maps, gsc])
  keywordMetricsStatus           KeywordMetricsStatus @default(idle)
  keywordMetricsTaskId           String?
  keywordMetricsRequestedAt      DateTime?
  keywordMetricsUpdatedAt        DateTime?
  keywordMetricsNextPollAt       DateTime?
  keywordMetricsPollAttempts     Int                  @default(0)
  keywordMetricsEstimatedCostUsd Decimal              @default(0) @db.Decimal(10, 6)
  keywordMetricsActualCostUsd    Decimal              @default(0) @db.Decimal(10, 6)
  keywordMetricsError            String?
  gscConnectionId                String?
  gscPropertyUrl                 String?
  gscPermissionLevel             String?
  gscConnectedAt                 DateTime?
  gscImportStatus                GscImportStatus      @default(idle)
  gscImportStartedAt             DateTime?
  gscLastImportedAt              DateTime?
  gscImportStartDate             DateTime?
  gscImportEndDate               DateTime?
  gscImportedRows                Int                  @default(0)
  gscImportError                 String?
  ga4ConnectionId                String?
  /// Canonical GA4 resource name, e.g. "properties/123456789".
  ga4PropertyId                  String?
  ga4PropertyName                String?
  ga4AccountName                 String?
  ga4ConnectedAt                 DateTime?
  ga4ImportStatus                GscImportStatus      @default(idle)
  ga4ImportStartedAt             DateTime?
  ga4LastImportedAt              DateTime?
  ga4ImportStartDate             DateTime?
  ga4ImportEndDate               DateTime?
  ga4ImportedRows                Int                  @default(0)
  ga4ImportError                 String?
  createdAt                      DateTime             @default(now())
  updatedAt                      DateTime             @updatedAt
  client                         Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  gscConnection                  GoogleConnection?    @relation("ProjectGscConnection", fields: [gscConnectionId], references: [id], onDelete: SetNull)
  ga4Connection                  GoogleConnection?    @relation("ProjectGa4Connection", fields: [ga4ConnectionId], references: [id], onDelete: SetNull)
  keywords                       Keyword[]
  locations                      Location[]
  competitors                    Competitor[]
  rankRuns                       RankRun[]
  gscSnapshots                   GscSnapshot[]
  reportExecutions               ReportExecution[]
  ga4Snapshots                   Ga4Snapshot[]

  @@index([clientId])
  @@index([gscConnectionId])
  @@index([ga4ConnectionId])
  @@index([scheduleEnabled, scheduleDay])
  @@index([keywordMetricsStatus, keywordMetricsNextPollAt])
}

/// One connected Google account. `grantedScopes` records exactly what the stored refresh token can do;
/// Search Console and Analytics access are granted separately and can live on the same row.
model GoogleConnection {
  id                    String    @id @default(cuid())
  accountEmail          String    @unique
  encryptedRefreshToken String
  grantedScopes         String[]
  connectedByEmail      String
  connectedAt           DateTime  @default(now())
  lastValidatedAt       DateTime?
  lastError             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  gscProjects           Project[] @relation("ProjectGscConnection")
  ga4Projects           Project[] @relation("ProjectGa4Connection")

  @@map("GoogleSearchConsoleConnection")
}

/// An API credential managed from Settings. The value is a JSON field map encrypted with the
/// server-held master key; only the fingerprint and a non-secret display hint are ever shown.
model AppSecret {
  id                     String    @id @default(cuid())
  name                   String    @unique
  encryptedValue         String
  fingerprint            String
  displayHint            String
  version                Int       @default(1)
  previousEncryptedValue String?
  previousFingerprint    String?
  previousDisplayHint    String?
  previousUpdatedAt      DateTime?
  /// When the current value was saved or restored; `updatedAt` also moves on verification checks.
  savedAt                DateTime  @default(now())
  previousSavedAt        DateTime?
  updatedByEmail         String
  lastVerifiedAt         DateTime?
  lastError              String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model Keyword {
  id               String                  @id @default(cuid())
  projectId        String
  phrase           String
  group            String?
  targetUrl        String?
  active           Boolean                 @default(true)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  searchVolume     Int?
  cpcUsd           Decimal?                @db.Decimal(10, 4)
  competition      Float?
  monthlySearches  Json?
  metricsUpdatedAt DateTime?
  project          Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  results          RankResult[]
  rankTasks        RankTask[]
  metricSnapshots  KeywordMetricSnapshot[]

  @@unique([projectId, phrase])
  @@index([projectId, active])
}

model Location {
  id                     String       @id @default(cuid())
  projectId              String
  name                   String
  countryCode            String       @default("GB")
  latitude               Float?
  longitude              Float?
  radiusMeters           Int?
  dataForSeoLocationName String?
  active                 Boolean      @default(true)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  project                Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  results                RankResult[]
  rankTasks              RankTask[]

  @@index([projectId, active])
  @@index([projectId, name])
}

model Competitor {
  id        String   @id @default(cuid())
  projectId String
  name      String
  domain    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
}

model RankRun {
  id               String            @id @default(cuid())
  projectId        String
  status           RankRunStatus     @default(queued)
  startedAt        DateTime?
  completedAt      DateTime?
  sandbox          Boolean           @default(true)
  source           RankRunSource     @default(sandbox)
  selection        Json?
  requestedByEmail String?
  availableAt      DateTime          @default(now())
  requestedTasks   Int               @default(0)
  submittedTasks   Int               @default(0)
  completedTasks   Int               @default(0)
  failedTasks      Int               @default(0)
  deliveryMethod   ApiDeliveryMethod @default(sandbox)
  estimatedCostUsd Decimal           @default(0) @db.Decimal(10, 6)
  actualCostUsd    Decimal           @default(0) @db.Decimal(10, 6)
  nextPollAt       DateTime?
  lastError        String?
  notes            String?
  createdAt        DateTime          @default(now())
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  apiRequests      ApiRequest[]
  results          RankResult[]
  rankTasks        RankTask[]
  reportExecution  ReportExecution?

  @@index([projectId, createdAt])
  @@index([status, availableAt, createdAt])
  @@index([status, deliveryMethod, nextPollAt])
}

model RankTask {
  id             String         @id @default(cuid())
  runId          String
  keywordId      String
  locationId     String
  searchType     SearchType
  device         Device
  status         RankTaskStatus @default(queued)
  externalTaskId String?        @unique
  requestBody    Json
  attempts       Int            @default(0)
  submittedAt    DateTime?
  completedAt    DateTime?
  lastError      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  run            RankRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  keyword        Keyword        @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  location       Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([runId, status])
  @@index([status, updatedAt])
  @@index([keywordId])
  @@index([locationId])
}

model KeywordMetricSnapshot {
  id              String   @id @default(cuid())
  keywordId       String
  locationName    String
  searchVolume    Int?
  cpcUsd          Decimal? @db.Decimal(10, 4)
  competition     Float?
  monthlySearches Json?
  checkedAt       DateTime @default(now())
  rawData         Json?
  keyword         Keyword  @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@index([keywordId, checkedAt])
}

model SystemLock {
  key         String   @id
  owner       String?
  lockedUntil DateTime
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  event      String
  outcome    String   @default("success")
  actorEmail String?
  actorRole  String?
  entityType String?
  entityId   String?
  ipAddress  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([event, createdAt])
  @@index([actorEmail, createdAt])
}

model RateLimitBucket {
  key             String   @id
  scope           String
  count           Int      @default(1)
  windowStartedAt DateTime
  expiresAt       DateTime
  updatedAt       DateTime @updatedAt

  @@index([expiresAt])
}

model WorkerHeartbeat {
  key              String    @id
  status           String    @default("never")
  startedAt        DateTime?
  completedAt      DateTime?
  lastSuccessAt    DateTime?
  lastFailureAt    DateTime?
  scheduled        Int       @default(0)
  submitted        Int       @default(0)
  collected        Int       @default(0)
  metricsSubmitted Int       @default(0)
  metricsCollected Int       @default(0)
  message          String?
  updatedAt        DateTime  @updatedAt
}

model RankResult {
  id           String         @id @default(cuid())
  runId        String
  keywordId    String
  locationId   String
  searchType   SearchType
  device       Device
  rankGroup    Int?
  rankAbsolute Int?
  matched      Boolean        @default(false)
  matchedName  String?
  matchedUrl   String?
  resultTitle  String?
  resultUrl    String?
  resultDomain String?
  direction    RankDirection?
  previousRank Int?
  checkedAt    DateTime       @default(now())
  rawItem      Json?
  run          RankRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  keyword      Keyword        @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  location     Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  serpFeatures SerpFeature[]

  @@unique([runId, keywordId, locationId, searchType, device])
  @@index([keywordId, locationId, searchType, device, checkedAt])
  @@index([runId])
  @@index([locationId])
}

model SerpFeature {
  id           String     @id @default(cuid())
  rankResultId String
  type         String
  title        String?
  url          String?
  rankGroup    Int?
  rankAbsolute Int?
  rawItem      Json?
  rankResult   RankResult @relation(fields: [rankResultId], references: [id], onDelete: Cascade)

  @@index([rankResultId, type])
}

model ApiRequest {
  id           String   @id @default(cuid())
  rankRunId    String?
  provider     String   @default("dataforseo")
  endpoint     String
  tag          String?
  sandbox      Boolean  @default(true)
  requestBody  Json
  responseBody Json?
  statusCode   Int?
  costUsd      Decimal  @default(0) @db.Decimal(10, 6)
  errorMessage String?
  createdAt    DateTime @default(now())
  rankRun      RankRun? @relation(fields: [rankRunId], references: [id], onDelete: SetNull)

  @@index([provider, createdAt])
  @@index([provider, sandbox, createdAt])
  @@index([rankRunId, createdAt])
}

model GscSnapshot {
  id          String   @id @default(cuid())
  projectId   String
  date        DateTime
  dimension   String   @default("daily_total")
  query       String?
  page        String?
  clicks      Int      @default(0)
  impressions Int      @default(0)
  ctr         Float?
  position    Float?
  rawData     Json?
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, date, dimension])
  @@index([projectId, date])
}

model Ga4Snapshot {
  id              String   @id @default(cuid())
  projectId       String
  date            DateTime
  /// "daily_total" for whole-property rows, "channel" for rows split by sessionDefaultChannelGroup.
  dimension       String   @default("daily_total")
  /// GA4 default channel group for dimension = "channel"; empty for daily totals.
  channel         String   @default("")
  sessions        Int      @default(0)
  /// Unique users for this row only. Never sum across dates or channels.
  activeUsers     Int      @default(0)
  newUsers        Int      @default(0)
  engagedSessions Int      @default(0)
  keyEvents       Float    @default(0)
  rawData         Json?
  createdAt       DateTime @default(now())
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, date, dimension, channel])
  @@index([projectId, date])
}
